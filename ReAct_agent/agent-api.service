[Unit]
Description=Monitoring System Agent API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/Monitoring-system/ReAct_agent
ExecStart=/opt/Monitoring-system/ReAct_agent/.venv/bin/python agent_api.py
Restart=always
RestartSec=5
User=root
Environment=PYTHONUNBUFFERED=1
MemoryMax=1536M
TasksMax=256

[Install]
WantedBy=multi-user.target
